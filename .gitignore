# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep example, ignore local secrets
.env.local
.env*.local

# SQLite database (local data — not committed)
/data/
*.db
*.db-shm
*.db-wal

# user uploads — local only, not committed (folder tracked via .gitkeep)
/public/uploads/*
!/public/uploads/.gitkeep

# generated outputs — local only, not committed (folder tracked via .gitkeep)
/public/outputs/*
!/public/outputs/.gitkeep

# storage — local runtime files, not committed (folders tracked via .gitkeep)
/storage/*
!/storage/.gitkeep
/storage/outputs/*
!/storage/outputs/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# .agents/ live workflow files (SUPERVISION.LOOP.1) — per-ticket scratch
# state, regenerated from .agents/templates/*, not tracked. See
# .agents/README.md.
.agents/current_task.md
.agents/claude_report.md
.agents/codex_review.md
.agents/codex_verdict.json
.agents/claude_followup.md
.agents/user_arbitration.md

# .agents/ live ticket state (Opus supervision protocol) — per-ticket scratch
# state, durable only via .agents/SUPERVISION_PROTOCOL.md, not tracked.
.agents/supervised_task.md
# Second lane's ticket file, when two conversations run in parallel — same
# nature as the one above, and named by the user (SUPERVISION_PROTOCOL.md §9).
.agents/supervised_task_*.md
.agents/executor_report.md
.agents/supervisor_review.md
.agents/supervisor_verdict.json

# Which conversation owns which paths, when two run in parallel on one working
# tree (decided by the user 2026-08-21). Live state by construction — it is
# true for as long as the two lanes are open and false the moment they close.
# The rules it applies belong to .agents/SUPERVISION_PROTOCOL.md; only the
# current occupancy lives in the file.
.agents/parallel_lanes.md

# .agents/ local working material — handoffs, one-off agent prompts, design
# references and per-executor skills. Same category as the live workflow files
# above: useful in a working copy, not part of the committed contract. Durable
# knowledge belongs in docs/, not here.
.agents/codex_handoff.md
.agents/deepseek_developer_prompt.md
.agents/opencv_storyboard_extraction_handoff.md
.agents/project_style_retake_buffer.md
.agents/style_1_c_architecture_context.md
.agents/style_1_c_architecture_prompt.md
.agents/design-references/
.agents/skills/

# Browser-validation artefacts (SUPERVISION — Playwright pass before verdict).
# Every pass regenerates page snapshots, console logs and downloaded fixtures
# here. They are evidence for one verdict, never part of the repository.
.agents/playwright-output/

# local backup-executor configuration (Cline / OpenRouter), machine-specific
.vscode/
.cline/
.clineignore
